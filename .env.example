# Algorise PayHR - Environment Configuration Template

PROJECT_NAME="Algorise PayHR"
ENVIRONMENT="production"
DEBUG=false

# 32-Byte (64-character hex) Key for AES-256-GCM PII Encryption (Replace before production)
PII_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# JWT Authentication
JWT_SECRET_KEY="replace-with-a-cryptographically-secure-random-string-at-least-64-bytes"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Hardware & CCTV Webhook HMAC Key
DEVICE_HMAC_SECRET="replace-with-a-secure-shared-hmac-key"

# Database & Redis
DATABASE_URL="postgresql+asyncpg://algorise:secure_db_pass@localhost:5432/algorise_payroll"
SYNC_DATABASE_URL="postgresql://algorise:secure_db_pass@localhost:5432/algorise_payroll"
REDIS_URL="redis://localhost:6379/0"

# Geofence Defaults
DEFAULT_GEOFENCE_RADIUS_METERS=50.0
GEOFENCE_BREACH_BUFFER_SECONDS=180
